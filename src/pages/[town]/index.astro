---
import { getCollection } from 'astro:content';
import { slugifyCategory } from '../../lib/categories';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingResults from '../../components/ListingResults.astro';
import ChipLinks from '../../components/ChipLinks.astro';

export async function getStaticPaths() {
  const towns = await getCollection('towns');
  return towns.map((town) => ({
    params: { town: town.data.slug },
    props: { town },
  }));
}

const { town } = Astro.props;
const allListings = await getCollection('listings');
const listings = allListings
  .filter((l) => l.data.town === town.data.slug)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const categoriesInTown = Array.from(new Set(listings.flatMap((l) => l.data.categories))).sort();
---

<BaseLayout
  title={`${town.data.name} recycling & waste services — Waste Info`}
  description={`Recycling, scrap, and waste removal services in ${town.data.name}.`}
>
  <Fragment slot="breadcrumb">
    <a href="/locations/">All locations</a> / {town.data.name}
  </Fragment>

  <h1>{town.data.name}</h1>
  {town.data.region && <p class="intro">{town.data.region}</p>}
  {town.data.intro && <p class="intro">{town.data.intro}</p>}

  <div class="sponsor-slot">
    <p class="sponsor-slot-label">Sponsored</p>
    <p class="sponsor-slot-text">
      Want your business featured here? <a href="/get-listed/">Get in touch</a> to
      sponsor the {town.data.name} page.
    </p>
  </div>

  <ChipLinks
    id="browse-by-category"
    label="Browse by category"
    items={categoriesInTown.map((category) => ({
      label: category,
      href: `/${town.data.slug}/${slugifyCategory(category)}/`,
    }))}
  />

  <ListingResults listings={listings} emptyMessage={`No listings yet for ${town.data.name}.`} />
</BaseLayout>

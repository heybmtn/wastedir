---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FEATURED_CATEGORIES, slugifyCategory } from '../lib/categories';

const towns = (await getCollection('towns')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);
const listings = await getCollection('listings');

const postcodesByTown = new Map<string, string[]>();
const countByTown = new Map<string, number>();
for (const listing of listings) {
  countByTown.set(listing.data.town, (countByTown.get(listing.data.town) ?? 0) + 1);
  if (!listing.data.postcode) continue;
  const existing = postcodesByTown.get(listing.data.town) ?? [];
  existing.push(listing.data.postcode);
  postcodesByTown.set(listing.data.town, existing);
}

const isCompactGrid = towns.length <= 4;

const townCoords = towns
  .filter((t) => t.data.lat != null && t.data.lon != null)
  .map((t) => ({ slug: t.data.slug, lat: t.data.lat, lon: t.data.lon }));

const quoteEmail = 'quotes@wastelist.uk';
---

<BaseLayout
  title="WasteList — Get quotes from local waste & recycling companies"
  description="Tell us what needs clearing and we'll pass your request to local, paid waste and recycling businesses."
>
  <h1>Get waste removed without the hassle</h1>
  <p class="intro">
    Tell us what you need cleared and we'll pass your request to local waste companies —
    instead of ringing round for quotes yourself.
  </p>

  <form class="listing-form" action={`mailto:${quoteEmail}`} method="post" enctype="text/plain">
    <div class="form-field">
      <label for="postcode">Postcode</label>
      <input type="text" id="postcode" name="Postcode" required />
    </div>

    <div class="form-field">
      <label for="waste-type">What do you need removed?</label>
      <select id="waste-type" name="Waste type" required>
        <option value="" selected disabled>Choose an option…</option>
        <option>Rubbish / junk</option>
        <option>House clearance</option>
        <option>Garden waste</option>
        <option>Builder's waste</option>
        <option>Furniture</option>
        <option>Skip hire</option>
        <option>Commercial waste</option>
        <option>Other</option>
      </select>
    </div>

    <div class="form-field">
      <label for="timing">When?</label>
      <select id="timing" name="Timing" required>
        <option value="" selected disabled>Choose an option…</option>
        <option>Today</option>
        <option>Tomorrow</option>
        <option>This week</option>
        <option>Flexible</option>
      </select>
    </div>

    <div class="form-field">
      <label for="email">Your contact email</label>
      <input type="email" id="email" name="Contact email" required />
    </div>

    <div class="form-field">
      <label for="phone">Phone (optional)</label>
      <input type="tel" id="phone" name="Phone" />
    </div>

    <div class="form-field">
      <label for="details">Additional details (optional)</label>
      <textarea
        id="details"
        name="Details"
        rows="4"
        placeholder="Roughly how much needs clearing, access for a van, anything else worth knowing."
      ></textarea>
    </div>

    <button type="submit" class="btn">Get my quotes</button>
  </form>

  <section class="section">
    <h2>Why use WasteList</h2>
    <ul class="trust-list">
      <li><strong>Free to use</strong> — there's no charge to request quotes.</li>
      <li><strong>Local</strong> — your request goes to waste companies covering your area.</li>
      <li><strong>One request, not ten calls</strong> — tell us once instead of ringing round.</li>
      <li><strong>No spam</strong> — your details are shared only with waste companies, never sold on.</li>
    </ul>
  </section>

  <section class="section">
    <h2>Browse by service</h2>
    <ul class="service-grid">
      {
        FEATURED_CATEGORIES.map(({ category, label }) => (
          <li>
            <a href={`/categories/${slugifyCategory(category)}/`}>{label}</a>
          </li>
        ))
      }
      <li>
        <a href="/categories/" class="service-grid-more">More →</a>
      </li>
    </ul>
  </section>

  <section class="section">
    <h2>Popular towns</h2>

    <div class="search-box">
      <label for="town-search">Search by town or postcode</label>
      <div class="search-input-wrap">
        <svg class="search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6" />
          <path d="M18 18l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          id="town-search"
          placeholder="Search by town or postcode…"
          autocomplete="off"
        />
      </div>
      <button type="button" class="use-location" id="use-location" hidden>Use my location</button>
      <p class="use-location-status" id="use-location-status" hidden></p>
    </div>

    <p class="search-empty" id="search-empty">No towns match your search.</p>

    <ul class={`card-grid ${isCompactGrid ? 'card-grid--compact' : ''}`} id="town-list">
      {
        towns.map((town) => {
          const postcodes = postcodesByTown.get(town.data.slug) ?? [];
          const count = countByTown.get(town.data.slug) ?? 0;
          return (
            <li
              data-name={town.data.name.toLowerCase()}
              data-postcodes={postcodes.join(' ').toLowerCase()}
            >
              <a href={`/${town.data.slug}/`}>
                {town.data.name}
                {town.data.region && <span class="card-subtitle">{town.data.region}</span>}
                <span class="card-count">
                  {count} service{count === 1 ? '' : 's'}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <script type="application/json" id="town-coords" set:html={JSON.stringify(townCoords)} is:inline />

  <script>
    const input = document.getElementById('town-search') as HTMLInputElement | null;
    const items = Array.from(document.querySelectorAll<HTMLLIElement>('#town-list li'));
    const empty = document.getElementById('search-empty');

    if (input) {
      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        const queryCompact = query.replace(/\s+/g, '');
        let visibleCount = 0;

        for (const item of items) {
          const haystack = `${item.dataset.name ?? ''} ${item.dataset.postcodes ?? ''}`;
          const haystackCompact = haystack.replace(/\s+/g, '');
          const matches =
            !query || haystack.includes(query) || haystackCompact.includes(queryCompact);
          item.hidden = !matches;
          if (matches) visibleCount++;
        }

        if (empty) empty.style.display = visibleCount === 0 ? 'block' : 'none';
      });
    }

    interface TownCoord {
      slug: string;
      lat: number;
      lon: number;
    }

    const coordsEl = document.getElementById('town-coords');
    const townCoords: TownCoord[] = coordsEl ? JSON.parse(coordsEl.textContent ?? '[]') : [];
    const locationBtn = document.getElementById('use-location') as HTMLButtonElement | null;
    const locationStatus = document.getElementById('use-location-status');

    if (locationBtn && 'geolocation' in navigator && townCoords.length > 0) {
      locationBtn.hidden = false;

      function haversine(lat1: number, lon1: number, lat2: number, lon2: number) {
        const toRad = (d: number) => (d * Math.PI) / 180;
        const R = 6371;
        const dLat = toRad(lat2 - lat1);
        const dLon = toRad(lon2 - lon1);
        const a =
          Math.sin(dLat / 2) ** 2 +
          Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }

      locationBtn.addEventListener('click', () => {
        if (locationStatus) {
          locationStatus.hidden = false;
          locationStatus.textContent = 'Finding your location…';
        }
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const { latitude, longitude } = pos.coords;
            let nearest = townCoords[0];
            let nearestDist = Infinity;
            for (const town of townCoords) {
              const dist = haversine(latitude, longitude, town.lat, town.lon);
              if (dist < nearestDist) {
                nearestDist = dist;
                nearest = town;
              }
            }
            window.location.href = `/${nearest.slug}/`;
          },
          () => {
            if (locationStatus) {
              locationStatus.textContent = "Couldn't determine your location.";
            }
          }
        );
      });
    }
  </script>
</BaseLayout>

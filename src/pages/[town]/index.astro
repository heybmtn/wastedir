---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingResults from '../../components/ListingResults.astro';

export async function getStaticPaths() {
  const towns = await getCollection('towns');
  return towns.map((town) => ({
    params: { town: town.data.slug },
    props: { town },
  }));
}

const { town } = Astro.props;
const allListings = await getCollection('listings');
const listings = allListings
  .filter((l) => l.data.town === town.data.slug)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title={`${town.data.name} recycling & waste services — WasteList`}
  description={`Paid recycling, scrap, and waste removal services in ${town.data.name}.`}
>
  <Fragment slot="breadcrumb">
    <a href="/">All towns</a> / {town.data.name}
  </Fragment>

  <h1>{town.data.name}</h1>
  {town.data.region && <p class="intro">{town.data.region}</p>}
  {town.data.intro && <p class="intro">{town.data.intro}</p>}

  <ListingResults listings={listings} emptyMessage={`No listings yet for ${town.data.name}.`} />
</BaseLayout>

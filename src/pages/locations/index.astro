---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const towns = (await getCollection('towns')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);
const listings = await getCollection('listings');
const countByTown = new Map<string, number>();
for (const listing of listings) {
  countByTown.set(listing.data.town, (countByTown.get(listing.data.town) ?? 0) + 1);
}
---

<BaseLayout title="All locations — WasteList" description="Browse every town covered by WasteList.">
  <Fragment slot="breadcrumb">
    <a href="/">Home</a> / All locations
  </Fragment>

  <h1>All locations</h1>
  <p class="intro">Every town covered by WasteList.</p>

  <ul class="card-grid" id="location-list">
    {
      towns.map((town) => {
        const count = countByTown.get(town.data.slug) ?? 0;
        return (
          <li>
            <a href={`/${town.data.slug}/`}>
              {town.data.name}
              {town.data.region && <span class="card-subtitle">{town.data.region}</span>}
              <span class="card-count">
                {count} service{count === 1 ? '' : 's'}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>

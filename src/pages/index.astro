---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FEATURED_CATEGORIES, slugifyCategory } from '../lib/categories';

const towns = (await getCollection('towns')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);
const listings = await getCollection('listings');

const postcodesByTown = new Map<string, string[]>();
for (const listing of listings) {
  if (!listing.data.postcode) continue;
  const existing = postcodesByTown.get(listing.data.town) ?? [];
  existing.push(listing.data.postcode);
  postcodesByTown.set(listing.data.town, existing);
}

const townData = towns.map((t) => ({
  slug: t.data.slug,
  name: t.data.name,
  postcodes: (postcodesByTown.get(t.data.slug) ?? []).join(' ').toLowerCase(),
  lat: t.data.lat,
  lon: t.data.lon,
}));
---

<BaseLayout
  title="Waste Info — Find trusted waste & recycling services near you"
  description="Compare local waste removal, recycling, skip hire and clearance services by town."
>
  <h1>Find trusted waste &amp; recycling services near you</h1>
  <p class="intro">
    Compare local waste removal, recycling, skip hire and clearance services.
  </p>

  <div class="search-box hero-search">
    <label for="town-search">Postcode or town</label>
    <form id="hero-search-form">
      <div class="hero-search-row">
        <div class="search-input-wrap">
          <svg class="search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6" />
            <path d="M18 18l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <input
            type="search"
            id="town-search"
            placeholder="Enter your postcode or town…"
            autocomplete="off"
          />
        </div>
        <button type="submit" class="btn">Find services</button>
      </div>
    </form>
    <button type="button" class="use-location" id="use-location" hidden>Use my location</button>
    <p class="use-location-status" id="use-location-status" hidden></p>
    <p class="search-status" id="search-status" hidden>
      No matching town found. <a href="/locations/">Browse all locations →</a>
    </p>
  </div>

  <section class="section">
    <h2>What do you need?</h2>
    <ul class="service-grid">
      {
        FEATURED_CATEGORIES.map(({ category, label, icon }) => (
          <li>
            <a class="service-card" href={`/categories/${slugifyCategory(category)}/`}>
              <span class="service-icon" set:html={icon} />
              <span class="service-card-label">{label}</span>
              <span class="service-card-cta">Find local pros →</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href="/categories/" class="service-grid-more">More →</a>
      </li>
    </ul>
  </section>

  <section class="section">
    <h2>Why Waste Info?</h2>
    <div class="trust-grid">
      <div>
        <h3>Find local</h3>
        <p>Search by postcode or town to find services in your area.</p>
      </div>
      <div>
        <h3>Compare options</h3>
        <p>Explore different waste and recycling services before choosing.</p>
      </div>
      <div>
        <h3>Save time</h3>
        <p>One place to find the service you need.</p>
      </div>
      <div>
        <h3>Support local businesses</h3>
        <p>Connect with waste and recycling companies operating near you.</p>
      </div>
    </div>
  </section>

  <section class="cta-block">
    <h2>Get your waste business in front of local customers</h2>
    <p>Join Waste Info and help people in your area find your services.</p>
    <a href="/get-listed/" class="btn">Get your business listed →</a>
  </section>

  <script type="application/json" id="town-data" set:html={JSON.stringify(townData)} is:inline />

  <script>
    interface TownData {
      slug: string;
      name: string;
      postcodes: string;
      lat?: number;
      lon?: number;
    }

    const dataEl = document.getElementById('town-data');
    const towns: TownData[] = dataEl ? JSON.parse(dataEl.textContent ?? '[]') : [];

    const input = document.getElementById('town-search') as HTMLInputElement | null;
    const heroForm = document.getElementById('hero-search-form');
    const searchStatus = document.getElementById('search-status');

    function findTown(query: string): TownData | undefined {
      const q = query.trim().toLowerCase();
      if (!q) return undefined;
      const qCompact = q.replace(/\s+/g, '');

      const exact = towns.find((t) => t.name.toLowerCase() === q);
      if (exact) return exact;

      return towns.find((t) => {
        const haystack = `${t.name.toLowerCase()} ${t.postcodes}`;
        const haystackCompact = haystack.replace(/\s+/g, '');
        return haystack.includes(q) || haystackCompact.includes(qCompact);
      });
    }

    input?.addEventListener('input', () => {
      if (searchStatus) searchStatus.hidden = true;
    });

    heroForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const match = findTown(input?.value ?? '');
      if (match) {
        window.location.href = `/${match.slug}/`;
        return;
      }
      if (searchStatus) searchStatus.hidden = false;
    });

    const locationBtn = document.getElementById('use-location') as HTMLButtonElement | null;
    const locationStatus = document.getElementById('use-location-status');
    const townCoords = towns.filter(
      (t): t is TownData & { lat: number; lon: number } => t.lat != null && t.lon != null
    );

    if (locationBtn && 'geolocation' in navigator && townCoords.length > 0) {
      locationBtn.hidden = false;

      function haversine(lat1: number, lon1: number, lat2: number, lon2: number) {
        const toRad = (d: number) => (d * Math.PI) / 180;
        const R = 6371;
        const dLat = toRad(lat2 - lat1);
        const dLon = toRad(lon2 - lon1);
        const a =
          Math.sin(dLat / 2) ** 2 +
          Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }

      locationBtn.addEventListener('click', () => {
        if (locationStatus) {
          locationStatus.hidden = false;
          locationStatus.textContent = 'Finding your location…';
        }
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const { latitude, longitude } = pos.coords;
            let nearest = townCoords[0];
            let nearestDist = Infinity;
            for (const town of townCoords) {
              const dist = haversine(latitude, longitude, town.lat, town.lon);
              if (dist < nearestDist) {
                nearestDist = dist;
                nearest = town;
              }
            }
            window.location.href = `/${nearest.slug}/`;
          },
          () => {
            if (locationStatus) {
              locationStatus.textContent = "Couldn't determine your location.";
            }
          }
        );
      });
    }
  </script>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const towns = await getCollection('towns');
  return towns.map((town) => ({
    params: { town: town.data.slug },
    props: { town },
  }));
}

const { town } = Astro.props;
const allListings = await getCollection('listings');
const listings = allListings
  .filter((l) => l.data.town === town.data.slug)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const serviceSet = new Set<string>();
const materialSet = new Set<string>();
for (const listing of listings) {
  for (const service of listing.data.services) serviceSet.add(service);
  for (const material of listing.data.materials ?? []) materialSet.add(material);
}
const services = Array.from(serviceSet).sort();
const materials = Array.from(materialSet).sort();

function jsonLd(listing: (typeof listings)[number]) {
  const data = listing.data;
  return JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: data.name,
    ...(data.description ? { description: data.description } : {}),
    ...(data.address || data.postcode
      ? {
          address: {
            '@type': 'PostalAddress',
            ...(data.address ? { streetAddress: data.address } : {}),
            ...(data.postcode ? { postalCode: data.postcode } : {}),
            addressCountry: 'GB',
          },
        }
      : {}),
    ...(data.phone ? { telephone: data.phone } : {}),
    ...(data.website ? { url: data.website } : {}),
  });
}
---

<BaseLayout
  title={`${town.data.name} recycling & waste services — WasteList`}
  description={`Recycling centres, scrap merchants, and waste collection services in ${town.data.name}.`}
>
  <Fragment slot="breadcrumb">
    <a href="/">All towns</a> / {town.data.name}
  </Fragment>

  <h1>{town.data.name}</h1>
  {town.data.region && <p class="intro">{town.data.region}</p>}
  {town.data.intro && <p class="intro">{town.data.intro}</p>}

  {
    services.length > 0 && (
      <div class="chip-group">
        <span class="chip-group-label">Service</span>
        <div class="chip-row" id="service-chip-row" role="group" aria-label="Filter by service">
          {services.map((service) => (
            <button type="button" class="chip" data-facet="service" data-tag={service} aria-pressed="false">
              {service}
            </button>
          ))}
        </div>
      </div>
    )
  }

  {
    materials.length > 0 && (
      <div class="chip-group">
        <span class="chip-group-label">Material</span>
        <div class="chip-row" id="material-chip-row" role="group" aria-label="Filter by material">
          {materials.map((material) => (
            <button type="button" class="chip" data-facet="material" data-tag={material} aria-pressed="false">
              {material}
            </button>
          ))}
        </div>
      </div>
    )
  }

  {
    (services.length > 0 || materials.length > 0) && (
      <button type="button" class="chip-clear" id="chip-clear">
        Clear filters
      </button>
    )
  }

  <p class="search-empty" id="listing-empty">No listings match the selected filters.</p>

  {
    listings.length === 0 ? (
      <p>No listings yet for {town.data.name}.</p>
    ) : (
      <ul class="listing-list" id="listing-list">
        {listings.map((listing) => {
          const data = listing.data;
          return (
            <li
              class="listing-card"
              data-services={data.services.join('|')}
              data-materials={(data.materials ?? []).join('|')}
            >
              <script type="application/ld+json" set:html={jsonLd(listing)} is:inline />
              <h3>{data.name}</h3>
              <p class="listing-categories">{data.categories.join(' · ')}</p>
              <ul class="listing-tags">
                {data.services.map((service) => (
                  <li class="tag-service">{service}</li>
                ))}
                {(data.materials ?? []).map((material) => (
                  <li class="tag-material">{material}</li>
                ))}
              </ul>
              {(data.address || data.postcode) && (
                <p class="listing-meta">
                  {[data.address, data.postcode].filter(Boolean).join(', ')}
                </p>
              )}
              {data.phone && <p class="listing-meta">{data.phone}</p>}
              {data.website && (
                <p class="listing-meta">
                  <a href={data.website} rel="noopener">
                    {data.website.replace(/^https?:\/\//, '')}
                  </a>
                </p>
              )}
              {data.description && <p class="listing-description">{data.description}</p>}
              {data.acceptedMaterials && data.acceptedMaterials.length > 0 && (
                <p class="listing-materials">
                  <strong>Accepts:</strong> {data.acceptedMaterials.join(', ')}
                </p>
              )}
              {data.hours && (
                <p class="listing-materials">
                  <strong>Hours:</strong> {data.hours}
                </p>
              )}
            </li>
          );
        })}
      </ul>
    )
  }

  <script>
    const clearBtn = document.getElementById('chip-clear');
    const cards = Array.from(document.querySelectorAll<HTMLLIElement>('#listing-list .listing-card'));
    const empty = document.getElementById('listing-empty');
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));

    if (chips.length > 0) {
      const activeByFacet = { service: new Set<string>(), material: new Set<string>() };

      function applyFilter() {
        const anyActive = activeByFacet.service.size > 0 || activeByFacet.material.size > 0;
        if (clearBtn) clearBtn.style.display = anyActive ? 'inline' : 'none';

        let visibleCount = 0;
        for (const card of cards) {
          const cardServices = (card.dataset.services ?? '').split('|');
          const cardMaterials = (card.dataset.materials ?? '').split('|');
          const matchesServices =
            activeByFacet.service.size === 0 ||
            cardServices.some((s) => activeByFacet.service.has(s));
          const matchesMaterials =
            activeByFacet.material.size === 0 ||
            cardMaterials.some((m) => activeByFacet.material.has(m));
          const matches = matchesServices && matchesMaterials;
          card.hidden = !matches;
          if (matches) visibleCount++;
        }
        if (empty) empty.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      for (const chip of chips) {
        chip.addEventListener('click', () => {
          const tag = chip.dataset.tag;
          const facet = chip.dataset.facet === 'material' ? 'material' : 'service';
          if (!tag) return;
          const isActive = chip.getAttribute('aria-pressed') === 'true';
          chip.setAttribute('aria-pressed', String(!isActive));
          if (isActive) activeByFacet[facet].delete(tag);
          else activeByFacet[facet].add(tag);
          applyFilter();
        });
      }

      clearBtn?.addEventListener('click', () => {
        activeByFacet.service.clear();
        activeByFacet.material.clear();
        for (const chip of chips) chip.setAttribute('aria-pressed', 'false');
        applyFilter();
      });

      applyFilter();
    }
  </script>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../content/config';
import BaseLayout from '../../layouts/BaseLayout.astro';

const towns = (await getCollection('towns')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

const contactEmail = 'listings@wastelist.uk';
---

<BaseLayout
  title="Get listed — WasteList"
  description="Add your recycling, scrap, or waste collection service to the WasteList directory."
>
  <Fragment slot="breadcrumb">
    <a href="/">All towns</a> / Get listed
  </Fragment>

  <h1>Get listed</h1>
  <p class="intro">
    Run a recycling centre, scrap yard, or waste collection service? Fill in the form below
    and we'll add you to the directory.
  </p>

  <form class="listing-form" action={`mailto:${contactEmail}`} method="post" enctype="text/plain">
    <div class="form-field">
      <label for="name">Business or service name</label>
      <input type="text" id="name" name="Business name" required />
    </div>

    <div class="form-field">
      <label for="town">Town</label>
      <input type="text" id="town" name="Town" list="town-options" required />
      <datalist id="town-options">
        {towns.map((town) => <option value={town.data.name} />)}
      </datalist>
    </div>

    <div class="form-field">
      <label for="category">Category</label>
      <select id="category" name="Category" required>
        <option value="" selected disabled>Choose a category…</option>
        {CATEGORIES.map((category) => <option value={category}>{category}</option>)}
      </select>
    </div>

    <div class="form-field">
      <label for="address">Address</label>
      <input type="text" id="address" name="Address" />
    </div>

    <div class="form-field">
      <label for="phone">Phone</label>
      <input type="tel" id="phone" name="Phone" />
    </div>

    <div class="form-field">
      <label for="website">Website</label>
      <input type="url" id="website" name="Website" placeholder="https://" />
    </div>

    <div class="form-field">
      <label for="email">Your contact email</label>
      <input type="email" id="email" name="Contact email" required />
    </div>

    <div class="form-field">
      <label for="details">Tell us about the service</label>
      <textarea
        id="details"
        name="Details"
        rows="5"
        placeholder="What materials do you accept, opening hours, and any tags that describe you (e.g. household waste, drop-off, free)."
      ></textarea>
    </div>

    <button type="submit">Send</button>
  </form>

  <p class="form-alt">
    Prefer email? Send the same details directly to
    <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
  </p>
</BaseLayout>

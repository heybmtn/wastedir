---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../content/config';
import BaseLayout from '../../layouts/BaseLayout.astro';

const towns = (await getCollection('towns')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

const contactEmail = 'listings@wastelist.uk';
---

<BaseLayout
  title="Get listed — WasteList"
  description="Add your paid recycling, scrap, or waste removal business to the WasteList directory."
>
  <Fragment slot="breadcrumb">
    <a href="/">All towns</a> / Get listed
  </Fragment>

  <h1>Get listed</h1>
  <p class="intro">
    Run a paid recycling, scrap, or waste removal business? Fill in the form below and
    we'll add you to the directory.
  </p>
  <p class="intro">
    We list paid recycling &amp; waste businesses only — not free council-run recycling
    centres or bin collections.
  </p>

  <form class="listing-form" action={`mailto:${contactEmail}`} method="post" enctype="text/plain">
    <div class="form-field">
      <label for="name">Business or service name</label>
      <input type="text" id="name" name="Business name" required />
    </div>

    <div class="form-field">
      <label for="town">Town</label>
      <input type="text" id="town" name="Town" list="town-options" required />
      <datalist id="town-options">
        {towns.map((town) => <option value={town.data.name} />)}
      </datalist>
    </div>

    <div class="form-field">
      <span class="form-field-label">Categories (select all that apply)</span>
      <div class="checkbox-group">
        {CATEGORIES.map((category) => (
          <label class="checkbox-option">
            <input type="checkbox" name="Category" value={category} />
            {category}
          </label>
        ))}
      </div>
    </div>

    <div class="form-field">
      <label for="address">Address</label>
      <input type="text" id="address" name="Address" />
    </div>

    <div class="form-field">
      <label for="phone">Phone</label>
      <input type="tel" id="phone" name="Phone" />
    </div>

    <div class="form-field">
      <label for="website">Website</label>
      <input type="url" id="website" name="Website" placeholder="https://" />
    </div>

    <div class="form-field">
      <label for="email">Your contact email</label>
      <input type="email" id="email" name="Contact email" required />
    </div>

    <div class="form-field">
      <label for="details">Tell us about the service</label>
      <textarea
        id="details"
        name="Details"
        rows="5"
        placeholder="What services you offer (e.g. skip hire, collection), what materials you accept (e.g. metal, wood, cardboard), and your opening hours."
      ></textarea>
    </div>

    <button type="submit">Send</button>
  </form>

  <p class="form-alt">
    Prefer email? Send the same details directly to
    <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
  </p>
</BaseLayout>
